# ==============================================================================
# GWC DATA.AI | Environment Variables Template
# ==============================================================================

# API Configuration
PROJECT_NAME="Enterprise Automated Resume Screening System"
ENV="development"
DEBUG=true
PORT=8000

# AI & Google Gemini LLM Configuration
GEMINI_API_KEY="your-gemini-api-key-here"

# Security & Webhook Authentication
HMAC_SECRET="your-secure-webhook-hmac-secret-here"

# File Processing Constraints
MAX_FILE_SIZE_MB=10

# Storage Settings
CSV_DATA_PATH="app/data/screening_results.csv"
JOB_RULES_PATH="app/config/job_rules.json"

# Email & SMTP Notification Settings
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@example.com"
SMTP_PASSWORD="your-app-password"
SENDER_EMAIL="your-sender@example.com"
HR_NOTIFICATION_EMAIL="hr-team@example.com"
ENABLE_EMAIL_NOTIFICATIONS=true

# Domo Cloud Integration Settings
DOMO_CLIENT_ID="your-domo-client-id"
DOMO_CLIENT_SECRET="your-domo-client-secret"
DOMO_DATASET_ID="your-domo-dataset-id"
DOMO_API_HOST="api.domo.com"
ENABLE_DOMO_SYNC=true
